{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": ".venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "build": ".venv/bin/python -c \"import shutil; shutil.copytree('app', 'dist/app', dirs_exist_ok=True)\"",
    "start": ".venv/bin/python -m uvicorn dist.app.main:app --port 8000",
    "lint": ".venv/bin/python -m compileall -q app",
    "check-types": ".venv/bin/python -m compileall -q app",
    "db:migrate": ".venv/bin/python -m alembic upgrade head",
    "db:check": ".venv/bin/python -m alembic check",
    "db:readiness": ".venv/bin/python -m scripts.check_database",
    "db:ingest": ".venv/bin/python -m scripts.ingest",
    "db:reembed": ".venv/bin/python -m scripts.reembed",
    "worker": ".venv/bin/python -m scripts.worker",
    "worker:once": ".venv/bin/python -m scripts.worker --once",
    "test": ".venv/bin/python -m unittest discover -s tests -v"
  }
}
