# Local Docker Compose database only. Never use this password in production.
DATABASE_URL=postgresql+psycopg://knowledge_graph:local_dev_password@localhost:5432/knowledge_graph

# Google OAuth 2.0 web client (Google Cloud Console → Google Auth Platform → Clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
WEB_ORIGIN=http://localhost:3000
