# Local Docker Compose database only. Never use this password in production.
DATABASE_URL=postgresql+psycopg://knowledge_graph:local_dev_password@localhost:5432/knowledge_graph

# Google OAuth 2.0 web client (Google Cloud Console → Google Auth Platform → Clients).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8000/drive/callback

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
WEB_ORIGIN=http://localhost:3000

# WAHA (WhatsApp HTTP API) sidecar — see docs/whatsapp.md. Development only.
WAHA_BASE_URL=http://localhost:3100
WAHA_API_KEY=
# Optional webhook for incremental sync; unset = poll-only mode.
# WAHA_WEBHOOK_URL=http://host.docker.internal:8000/whatsapp/webhooks
# WAHA_WEBHOOK_SECRET=

# Self-hosted encoder. A different model must emit 384-dimensional vectors and
# needs a re-embed (python -m scripts.reembed). Device defaults to CPU.
# EMBEDDING_MODEL=intfloat/multilingual-e5-small
# EMBEDDING_DEVICE=cpu
# EMBEDDING_BATCH_SIZE=32
